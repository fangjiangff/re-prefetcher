# Python cache and local environments
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# Build outputs and generated binaries
bin/
/sms/bin/
/stride-prefetcher/bin/
/cmc/bin/
/attacks/bin/
/src/bin/

# Generated local result/cache directories
res/
/cmc/res/
.matplotlib/

# Kernel module build outputs
/kernel-modules/**/*.o
/kernel-modules/**/*.ko
/kernel-modules/**/*.mod
/kernel-modules/**/*.mod.c
/kernel-modules/**/.*.cmd
/kernel-modules/**/.tmp_versions/
/kernel-modules/**/Module.symvers
/kernel-modules/**/modules.order
/kernel-modules/bop-el0-el1/test_bop_el0_el1
/kernel-modules/prefetch-pmu-event/probe_prefetch_pmu

# Ignore local editor/OS files
*.swp
*.swo
*.bak
.DS_Store
*.tmp
*~

# Logs and temporary outputs
*.log
*.out
*.err
core
core.*

# Track only the selected gadget-detection sources
/gadget_detect/*
!/gadget_detect/LLVM_FIX/
!/gadget_detect/LLVM_FIX/**
!/gadget_detect/codes/
/gadget_detect/codes/*
!/gadget_detect/codes/search_gadget.sh

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://re-prefetcher.local/schemas/target.schema.json",
  "title": "Prefetch experiment target",
  "type": "object",
  "required": ["schema_version", "id", "label", "architecture", "cpu", "timing", "capabilities", "execution"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "label": {"type": "string"},
    "architecture": {"type": "string"},
    "cpu": {
      "type": "object",
      "required": ["model", "core"],
      "properties": {
        "model": {"type": "string"},
        "core": {"type": "integer", "minimum": 0},
        "midr": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "timing": {
      "type": "object",
      "required": ["source", "unit", "cache_hit_threshold", "calibration_required"],
      "properties": {
        "source": {"type": "string"},
        "unit": {"type": "string"},
        "cache_hit_threshold": {"type": "number", "exclusiveMinimum": 0},
        "calibration_required": {"type": "boolean"}
      }
    },
    "pmu": {"type": "object"},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "execution": {"type": "object"}
  },
  "additionalProperties": false
}

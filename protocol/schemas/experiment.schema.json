{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://re-prefetcher.local/schemas/experiment.schema.json",
  "title": "Prefetch experiment definition",
  "type": "object",
  "required": ["schema_version", "id", "family", "goal", "requires", "variables", "command", "observations", "controls", "artifacts", "sources"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]*$"},
    "family": {"type": "string"},
    "goal": {"type": "string"},
    "requires": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "variables": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "default"],
        "properties": {
          "type": {"enum": ["integer", "number", "boolean", "string"]},
          "default": {},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "enum": {"type": "array"}
        },
        "additionalProperties": false
      }
    },
    "command": {
      "type": "object",
      "required": ["argv", "requires_privilege"],
      "properties": {
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "requires_privilege": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "observations": {"type": "array", "items": {"type": "string"}},
    "controls": {"type": "array", "items": {"type": "string"}},
    "artifacts": {"type": "array", "items": {"type": "string"}},
    "sources": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

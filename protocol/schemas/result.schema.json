{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://re-prefetcher.local/schemas/result.schema.json",
  "title": "Prefetch experiment result envelope",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "experiment", "target", "execution", "observations", "evidence", "artifacts", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string"},
    "status": {"enum": ["completed", "failed", "aborted"]},
    "experiment": {"type": "object"},
    "target": {"type": "object"},
    "execution": {"type": "object", "required": ["started_at", "finished_at", "return_code", "command", "host"]},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value"],
        "properties": {
          "name": {"type": "string"},
          "value": {},
          "unit": {"type": ["string", "null"]},
          "case": {"type": ["string", "null"]},
          "uncertainty": {"type": ["number", "null"]}
        }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": {"enum": ["observed", "supported", "inferred", "speculative", "inconclusive", "unassessed"]},
        "reason": {"type": "string"}
      }
    },
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

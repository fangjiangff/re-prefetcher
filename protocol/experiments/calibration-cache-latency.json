{
  "schema_version": "1.0",
  "id": "calibration.cache-latency",
  "family": "calibration",
  "goal": "Record target timing distributions before characterization",
  "requires": ["cpu_affinity", "cache_probe"],
  "variables": {
    "samples": {"type": "integer", "default": 1000, "minimum": 100},
    "array_mb": {"type": "integer", "default": 256, "minimum": 16},
    "seed": {"type": "integer", "default": 1592594996, "minimum": 0}
  },
  "command": {
    "argv": ["python3", "{repo}/attacks/test-load-vs-sw-latency.py", "--arch", "{target.label}", "--core", "{target.cpu.core}", "--samples", "{samples}", "--array-mb", "{array_mb}", "--seed", "{seed}", "--output-dir", "{run.output_dir}/calibration", "--csv", "{run.output_dir}/calibration/latency.csv"],
    "requires_privilege": false
  },
  "observations": ["latency_distribution", "timer_baseline"],
  "controls": ["empty_timer_baseline", "demand_load_miss"],
  "artifacts": ["calibration/latency.csv", "calibration/*.png"],
  "sources": ["attacks/test-load-vs-sw-latency.py", "attacks/test-load-vs-sw-latency.cc"]
}

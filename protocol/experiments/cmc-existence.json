{
  "schema_version": "1.0",
  "id": "cmc.existence",
  "family": "temporal_correlation",
  "goal": "Compare an untrained random address chain with a trained chain",
  "requires": ["aarch64", "cpu_affinity", "cache_flush", "cache_probe", "cpp_rctx", "direct_pmu"],
  "variables": {
    "rounds": {"type": "integer", "default": 5000, "minimum": 100},
    "training_replays": {"type": "integer", "default": 8, "minimum": 1},
    "wait_nops": {"type": "integer", "default": 1000, "minimum": 0}
  },
  "command": {
    "argv": ["python3", "{repo}/re2-cmc/test-cmc.py", "--arch", "{target.label}", "--core", "{target.cpu.core}", "--rounds", "{rounds}", "--training-replays", "{training_replays}", "--wait-nops", "{wait_nops}", "--threshold-ns", "{target.timing.cache_hit_threshold}", "--output", "{run.output_dir}/cmc-existence.tsv", "--no-plot"],
    "requires_privilege": true
  },
  "observations": ["l1_prefetch_per_round", "l2_prefetch_per_round", "node_hit_rate", "node_avg_latency"],
  "controls": ["untrained_chain", "separate_pmu_and_cache_probe_runs"],
  "artifacts": ["cmc-existence.tsv"],
  "sources": ["re2-cmc/test-cmc.py", "re2-cmc/test-cmc.c", "re0-stride-prefetcher/until.c"]
}

{
  "schema_version": "1.0",
  "id": "bop.existence",
  "family": "best_offset",
  "goal": "Compare fixed-offset training against an untrained baseline",
  "requires": ["aarch64", "cpu_affinity", "cache_flush", "cache_probe", "cpp_rctx", "direct_pmu"],
  "variables": {
    "rounds": {"type": "integer", "default": 100, "minimum": 10},
    "train_pairs": {"type": "integer", "default": 1024, "minimum": 1, "maximum": 3500},
    "trigger_batch": {"type": "integer", "default": 2, "minimum": 2},
    "wait_nops": {"type": "integer", "default": 2000, "minimum": 0}
  },
  "command": {
    "argv": ["python3", "{repo}/re3-bop/test-bop.py", "--arch", "{target.label}", "--core", "{target.cpu.core}", "--rounds", "{rounds}", "--train-pairs", "{train_pairs}", "--trigger-batch", "{trigger_batch}", "--wait-nops", "{wait_nops}", "--threshold-ns", "{target.timing.cache_hit_threshold}", "--output", "{run.output_dir}/bop-existence.tsv", "--no-plot"],
    "requires_privilege": true
  },
  "observations": ["l1_prefetch_per_trigger", "l2_prefetch_per_trigger", "target_hit_rate", "target_avg_latency"],
  "controls": ["untrained", "fixed_offset_expected", "separate_pmu_and_cache_probe_runs"],
  "artifacts": ["bop-existence.tsv", "bop-existence-pmu.tsv", "bop-existence-cache.tsv"],
  "sources": ["re3-bop/test-bop.py", "re3-bop/test-bop.c", "re0-stride-prefetcher/until.c"]
}

{
  "schema_version": "1.0",
  "id": "region.existence",
  "family": "region",
  "goal": "Compare trained footprint replay against an untrained-PC control",
  "requires": ["aarch64", "cpu_affinity", "cache_flush", "cache_probe", "cpp_rctx", "direct_pmu"],
  "variables": {
    "rounds": {"type": "integer", "default": 4000, "minimum": 100},
    "train_regions": {"type": "integer", "default": 32, "minimum": 1},
    "wait_nops": {"type": "integer", "default": 1000, "minimum": 0},
    "access": {"type": "string", "default": "load", "enum": ["load", "store"]}
  },
  "command": {
    "argv": ["python3", "{repo}/re1-region-prefetcher/test-exist.py", "--arch", "{target.label}", "--core", "{target.cpu.core}", "--rounds", "{rounds}", "--train-regions", "{train_regions}", "--wait-nops", "{wait_nops}", "--type", "{access}", "--hit-threshold", "{target.timing.cache_hit_threshold}", "--output", "{run.output_dir}/region-existence.txt", "--no-plot"],
    "requires_privilege": true
  },
  "observations": ["l1_prefetch_per_round", "l2_prefetch_per_round", "line_hit_rate", "line_avg_latency"],
  "controls": ["untrained_pc_same_trigger_access", "separate_pmu_and_cache_probe_runs"],
  "artifacts": ["region-existence.txt"],
  "sources": ["re1-region-prefetcher/test-exist.py", "re1-region-prefetcher/test-exist.c", "re0-stride-prefetcher/until.c"]
}
